# API Configuration
# Uncomment and set your API URL for development

# For Physical Android Device (replace with your computer's IP)
EXPO_PUBLIC_API_URL=http://192.168.1.103:3000/api

# For Android Emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# For iOS Simulator (default: localhost)
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# For Production Build
# EXPO_PUBLIC_API_URL=https://your-production-api.com/api

# Environment
NODE_ENV=development

